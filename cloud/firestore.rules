rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/automation/{device} {
      allow get, list: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['schema','payload','receivedAt'])
        && request.resource.data.schema == 1
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 60000
        && request.resource.data.receivedAt == request.time;
      allow delete: if false;
    }
    match /users/{uid}/sync/state {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['schema', 'payload'])
        && request.resource.data.schema == 1
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 850000;
      allow list, delete: if false;
    }
  }
}

